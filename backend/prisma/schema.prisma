generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  RECRUITER
  MENTOR
  ADMIN
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  HIRED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  education Education[]
  skills    UserSkill[]
  enrollments CourseEnrollment[]
  postedJobs Job[]
  applications JobApplication[]
  passwordResetTokens PasswordResetToken[]
  mentorProfile MentorProfile?
  sentMentorshipRequests MentorshipRequest[] @relation("StudentMentorshipRequests")
  receivedMentorshipRequests MentorshipRequest[] @relation("MentorMentorshipRequests")
  notifications Notification[]

  @@index([role])
  @@map("users")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String    @db.VarChar(160)
  body      String    @db.Text
  type      String    @db.VarChar(40)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MentorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String   @db.Text
  expertise    String[]
  availability String   @db.VarChar(160)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

model MentorshipRequest {
  id        String                  @id @default(uuid())
  studentId String
  mentorId  String
  status    MentorshipRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  student User @relation("StudentMentorshipRequests", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("MentorMentorshipRequests", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([studentId, mentorId])
  @@index([mentorId, status])
  @@map("mentorship_requests")
}

model Course {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(160)
  description String   @db.Text
  category    String   @db.VarChar(80)
  level       String   @db.VarChar(30)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseEnrollment[]
  activities  CourseActivity[]

  @@index([published, category])
  @@map("courses")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  progress  Int      @default(0)
  enrolledAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions CourseActivityCompletion[]

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_enrollments")
}

model CourseActivity {
  id          String   @id @default(uuid())
  courseId    String
  title       String   @db.VarChar(160)
  description String   @db.Text
  position    Int
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions CourseActivityCompletion[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_activities")
}

model CourseActivityCompletion {
  id           String   @id @default(uuid())
  enrollmentId String
  activityId   String
  completedAt  DateTime @default(now())

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activity   CourseActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, activityId])
  @@map("course_activity_completions")
}

model Education {
  id           String   @id @default(uuid())
  userId       String
  degree       String   @db.VarChar(100)
  institution  String   @db.VarChar(200)
  fieldOfStudy String   @db.VarChar(150)
  startYear    Int
  endYear      Int?
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("education")
}

model UserSkill {
  id          String           @id @default(uuid())
  userId      String
  name        String           @db.VarChar(80)
  proficiency SkillProficiency @default(BEGINNER)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_skills")
}

model Job {
  id             String    @id @default(uuid())
  recruiterId    String
  companyName    String    @db.VarChar(160)
  title          String    @db.VarChar(160)
  description    String    @db.Text
  location       String    @db.VarChar(120)
  employmentType String    @db.VarChar(40)
  requiredSkills String[]
  status         JobStatus @default(OPEN)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recruiter   User            @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([status, createdAt])
  @@index([recruiterId])
  @@map("jobs")
}

model JobApplication {
  id          String            @id @default(uuid())
  jobId       String
  studentId   String
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([studentId, status])
  @@map("job_applications")
}
